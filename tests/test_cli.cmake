if(NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "Built renderer is required")
endif()
function(check_case label expected_exit expected_text)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 15)
    if(NOT "${code}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${label}: unexpected exit=${code}; ${out}; ${err}")
    endif()
    string(FIND "${out}${err}" "${expected_text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${label}: expected ${expected_text}; ${out}; ${err}")
    endif()
endfunction()
get_filename_component(test_dir "${TEST_OUTPUT}" DIRECTORY)
set(unicode_output "${test_dir}/中文输出/三角形.ppm")
check_case(unicode_render 0 "Rendered triangle" --scene triangle --mode tile
    --width 64 --height 48 --shader color --output "${unicode_output}")
file(SIZE "${unicode_output}" unicode_bytes)
if(NOT unicode_bytes EQUAL 9229)
    message(FATAL_ERROR "Unicode output PPM payload length is wrong")
endif()
check_case(version 0 "MiniRaster ${EXPECTED_VERSION}" --version)
check_case(help 0 "Usage: miniraster" --help)
check_case(bad_width 2 "error:" --width 0)
check_case(bad_option 2 "error:" --unknown value)
check_case(render 0 "Rendered triangle" --scene triangle --mode reference
    --width 64 --height 48 --shader color --output "${TEST_OUTPUT}")
file(READ "${TEST_OUTPUT}" header LIMIT 13)
if(NOT header MATCHES "P6\n64 48\n255\n")
    message(FATAL_ERROR "Rendered PPM header is wrong")
endif()
file(SIZE "${TEST_OUTPUT}" output_bytes)
if(NOT output_bytes EQUAL 9229)
    message(FATAL_ERROR "PPM payload length is wrong: ${output_bytes}")
endif()
